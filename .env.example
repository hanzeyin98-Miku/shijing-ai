# 复制为 .env 后填写。密钥仅放在服务端，切勿放进 src/ 或提交到代码仓库。
# 意象提取：POST JSON，响应需符合 INTEGRATIONS.md 中的 imagery 契约。
IMAGERY_API_URL=
IMAGERY_API_KEY=
IMAGERY_API_MODEL=

# 图像生成：POST JSON，响应需包含 imageUrl；若为异步任务，适配器负责轮询至生成完成。
IMAGE_GENERATION_API_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_API_MODEL=

# 图谱、问答、色彩共用同一个 POST JSON API；根据请求 mode 区分 graph / qa / color。
POETRY_ASSISTANT_API_URL=
POETRY_ASSISTANT_API_KEY=
POETRY_ASSISTANT_API_MODEL=

PORT=8787
